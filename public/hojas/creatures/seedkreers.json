{
  "texts": [
    {
      "content": "Small herbivorous creatures that build their nests within rock crevices, drilling into\nthe stone with a specialized drill-like tentacle.",
      "left": "288.9px",
      "top": "248.6px",
      "scale": "1.2000000000000002",
      "rotate": "0",
      "fontFamily": "windsol",
      "fontSize": "24px",
      "color": "rgb(0, 0, 0)"
    },
    {
      "content": "Seedkres play a vital role in seed dispersal, encouraging the\ngrowth of new plants in rocky and arid environments.",
      "left": "302.8px",
      "top": "674.4px",
      "scale": "1.4000000000000004",
      "rotate": "0",
      "fontFamily": "windsol",
